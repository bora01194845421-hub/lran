# ==============================
# 이란전쟁 에이전트 API 키 설정
# 이 파일을 .env 로 복사 후 키 입력
# ==============================

# [필수] Anthropic Claude API — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-

# [선택] NewsAPI — newsapi.org (무료 100회/월)
NEWSAPI_KEY=

# [선택] The Guardian — open-platform.theguardian.com (무료)
GUARDIAN_API_KEY=

# [선택] New York Times — developer.nytimes.com (무료 500회/일)
NYT_API_KEY=

# [선택] Brave Search — api.search.brave.com (무료 2000회/월)
BRAVE_API_KEY=

# [선택] 오피넷 (유가) — www.opinet.co.kr 회원가입 후 발급
OPINET_API_KEY=

# [선택] KOSIS 통계청 — kosis.kr/openapi 무료 발급
KOSIS_API_KEY=

# [선택] YouTube Data API — console.cloud.google.com
YOUTUBE_API_KEY=
